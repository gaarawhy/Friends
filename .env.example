# --- Discord (obrigatório) ---

# Bot > Reset Token, no Discord Developer Portal
DISCORD_BOT_TOKEN=

# ID do servidor: com o modo desenvolvedor ligado, botão direito no servidor > Copiar ID
DISCORD_GUILD_ID=

# General Information > Application ID
DISCORD_APPLICATION_ID=

# General Information > Public Key
DISCORD_PUBLIC_KEY=

# --- Opcionais ---

# Lista inicial de membros, o mesmo JSON de data/allowed-members.json em uma
# linha só. Usada quando não há disco gravável (Vercel e afins). Se o arquivo
# existir, ele tem preferência.
# Ex.: [{"id":"1234","nitro":"nitro-ouro","badges":["apoiador"]}]
ALLOWED_MEMBERS=

# Onde gravar os JSONs de estado. O padrão é data/ no projeto, ou a pasta
# temporária quando o deploy é somente leitura.
DATA_DIR=

# Tempero do hash dos IPs no contador de visitas.
# Trocar esse valor zera a contagem: os hashes antigos deixam de bater.
VIEW_SALT=
